# Copy to .env (same folder) and fill in the values from the dashboard (Yönetim → Robotlar).
ROBOT_API_URL=https://your-app.vercel.app
ROBOT_DEVICE_ID=robot_xxxxxxxx
ROBOT_DEVICE_TOKEN=rbt_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Push-to-talk: keyboard (Enter to start/stop), screen (on-screen button / Space; touchscreens)
# or gpio (hold a button on ROBOT_BUTTON_PIN, BCM numbering). `main.py --desktop` always uses screen.
ROBOT_TRIGGER=keyboard
ROBOT_BUTTON_PIN=17

# Screen: window (desktop), fullscreen (robot LCD) or console (no screen)
ROBOT_DISPLAY=window
ROBOT_SCREEN_WIDTH=480
ROBOT_SCREEN_HEIGHT=320

# Audio devices: leave empty for the system default, or give an index / part of the name
# from `python -m sounddevice`, e.g. ROBOT_INPUT_DEVICE=USB
ROBOT_INPUT_DEVICE=
ROBOT_OUTPUT_DEVICE=

ROBOT_MAX_RECORDING_SECONDS=30
ROBOT_HEARTBEAT_SECONDS=30
ROBOT_LOG_LEVEL=INFO
# Only for testing against a plain-http server on your LAN (never in production):
# ROBOT_ALLOW_INSECURE=1
