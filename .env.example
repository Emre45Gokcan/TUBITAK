# --- Database -------------------------------------------------------------
# Local: `npm run db:local` starts Postgres on port 5433 (no Docker needed).
# Vercel: the Neon integration sets both variables automatically
# (DATABASE_URL = pooled, DATABASE_URL_UNPOOLED = direct, used for migrations).
DATABASE_URL=postgres://postgres:postgres@localhost:5433/app
DATABASE_URL_UNPOOLED=postgres://postgres:postgres@localhost:5433/app

# --- Better Auth -------------------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL of the app. On Vercel set this to the production URL.
BETTER_AUTH_URL=http://localhost:3000

# --- Email (Resend) ----------------------------------------------------------
# Leave empty in development: emails (with their links) are printed to the terminal.
RESEND_API_KEY=
# Must use a domain verified in Resend, e.g. "Sınıf Platformu <no-reply@okulunuz.com>"
EMAIL_FROM=

# Shown in emails and the page title.
APP_NAME=Sınıf Platformu

# --- First admin (npm run db:seed) -------------------------------------------
ADMIN_NAME=Yönetici
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# --- Robot companion (Raspberry Pi) --------------------------------------
# Conversation (Claude). Get a key at console.anthropic.com.
ANTHROPIC_API_KEY=
# Speech-to-text and text-to-speech (OpenAI audio API).
OPENAI_API_KEY=
# Optional model overrides (defaults shown).
# OPENAI_STT_MODEL=gpt-4o-mini-transcribe
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# Development only: fake STT/LLM/TTS (no keys, no cost). Ignored on Vercel production.
ROBOT_AI_MOCK=
